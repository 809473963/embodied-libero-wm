  ],
  "input_contract": {
    "visual": "frozen natural-RGB CLIP ViT-B/32 global projection [512]",
    "language": "frozen task-language feature [512]",
    "proprio": "frozen 12-D proprioception, ablation only",
    "forbidden_inputs": ["expert action", "future expert action", "action MSE", "reward", "done", "success", "task outcome", "simulator state", "object pose"],
    "label": "temporal ordering and normalized index in existing expert demonstrations",
    "interpretation": "demonstration-progress preference, not task-optimal value"
  },
  "pair_construction": {
    "gap_bins": ["1-2", "3-4", "5-8", "9-16", ">16", "terminal-anchor"],
    "gt16_gap_support": "17 through min(32, trajectory_length-1)",
    "per_demo_per_bin_forward": 32,
    "include_exact_reverse_for_every_same_demo_pair": true,
    "sampling": "deterministic evenly spaced indices in each finite pair population",
    "local_primary_bins": ["1-2", "3-4", "5-8"],
    "terminal_anchor_separate_from_local": true,
    "cross_demo_points": 16,
    "cross_demo_matched_progress": "same task, cyclic different demo, 16 equal normalized-progress anchors from 0.1 to 0.9",
    "cross_demo_mismatched_progress": "same task, cyclic different demo, normalized-progress separation 0.25, both directions",
    "no_synthetic_images": true
  },
  "models": {
    "V0": {
      "name": "task-conditioned terminal prototype similarity",
      "terminal_tail_states": 8,
      "prototype_source": "calibration demos only",
      "score": "cosine similarity between frozen visual feature and task prototype"
    },
    "V1": {
      "name": "absolute scalar normalized-progress predictor",
      "input": ["visual", "language"],
      "architecture": "Linear(1024,64)-GELU-Linear(64,1)",
      "pair_score": "V1(sb)-V1(sa)"
    },
    "V2": {
      "name": "antisymmetric pairwise progress predictor",
      "primary_input": ["za", "zb", "zb-za", "language"],
      "architecture": "raw MLP Linear(input,64)-GELU-Linear(64,1); final logit raw(a,b,l)-raw(b,a,l)",
      "trainable_parameter_max": 200000,
      "primary_condition": "visual+language",
      "ablations": ["proprio+language", "visual+proprio+language"]
    }
  },
  "training": {
    "seed": 11,
    "epochs": 40,
    "batch_size": 512,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "V1_loss": "mean squared error to normalized trajectory progress",
    "V2_loss": "binary cross entropy with logits to temporal-order preference",
    "feature_standardization": "calibration-only mean/std with 1e-6 floor; frozen for evaluation",
    "selection": "none; architecture, epoch count, threshold 0.5, and primary condition are fixed before calibration"
  },
  "probability_calibration": {
    "applies_to": ["V0", "V1"],
    "temperature_grid": [0.5, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000],
    "selection": "calibration same-demo pair log loss",
    "V2": "native sigmoid of antisymmetric logit"
  },
  "controls": {
    "wrong_language": "deterministic task derangement task_id -> (task_id+1) mod 10",
    "symmetry": "P(b>a)+P(a>b), structurally exact for V2 and reported numerically",
    "scene_time_shortcut": ["cross-demo matched-progress neutrality", "cross-demo mismatched-progress preference"],
    "robot_shortcut": ["proprio+language", "visual+proprio+language"],
    "monotonicity_gaps": [1, 4, 8, 16]
  },
  "statistics": {
    "bootstrap_replicates": 10000,
    "bootstrap_seed": 20261002,
    "unit": "task-stratified demo block; resample four complete demos per task",
    "confidence_interval": "percentile 95%"
  },
  "decision_rules": {
    "local_accuracy_min": 0.65,
    "local_ci_lower_min": 0.55,
    "positive_task_min": 7,
    "wrong_language_drop_min": 0.05,
    "wrong_language_ci_lower_strictly_positive": true,
    "robot_shortcut_accuracy_floor": 0.65,
    "robot_shortcut_required_visual_margin": 0.02,
    "v2_noninferiority_margin": 0.02,
    "pairwise_outperformance_min": 0.02,
    "terminal_accuracy_high": 0.80,
    "pass_labels": ["GOAL_CONDITIONED_PROGRESS_VALID", "CANDIDATE_VALUE_REPRESENTATION_VALID"],
    "pass_authorization": "GO_WORLD_MODEL_INTERFACE_AUDIT",
    "fail_label": "CANDIDATE_VALUE_AUDIT_BLOCKED",
    "fail_authorization": "BLOCK_WORLD_MODEL_INTERFACE_AUDIT",
    "spatial_world_model_always": "BLOCK_SPATIAL_WM_PROTOTYPE",
    "controller_always": false
  },
  "outputs": {
    "directory": "results/goal_conditioned_pairwise_progress",
    "report": "docs/goal_conditioned_pairwise_progress_audit.md"
  },
  "forbidden": [
